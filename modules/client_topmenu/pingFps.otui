testPingPanel < UIWidget
  height: 20
  width: 180
  anchors.fill: parent
  focusable: false
  phantom: true

  UIWidget
    id: pingImg
    size: 17 17
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    phantom: true
    focusable: false

  UIWidget
    id: pingFpsLabel
    height: 17
    anchors.left: prev.right
    anchors.right: parent.right
    anchors.verticalCenter: prev.verticalCenter
    margin-left: 5
    phantom: true
    font: verdana-11px-rounded
    text-align: left
    text-offset: 0 1
    focusable: false


Panel
  id: pingWidget
  anchors.top: parent.top
  anchors.left: parent.left
  margin-top: 10
  margin-left: 10
  width: 180
  layout:
    type: verticalBox
    fit-children: true
    spacing: 4
  phantom: true
  focusable: false

  Panel
    id: pingRow
    height: 20
    phantom: true
    focusable: false

  Panel
    id: fpsRow
    height: 20
    phantom: true
    focusable: false
